rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own saved reports.
    // Only sealed (anonymised) text is ever stored here.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Doctor share links: anyone with the unguessable link can read until it expires.
    // Only the owner can create (for at most 30 days) or delete one. Shares can't be edited or listed.
    match /shares/{shareId} {
      allow get: if resource.data.expiresAt > request.time;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(31, 'd')
        && request.resource.data.keys().hasOnly(['owner', 'createdAt', 'expiresAt', 'month', 'language', 'summary', 'urgent', 'findings', 'questions', 'trends', 'critical', 'where']);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow update: if false;
    }
  }
}
